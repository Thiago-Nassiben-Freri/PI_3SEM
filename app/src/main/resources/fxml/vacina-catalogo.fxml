<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.pi3sem.desktop.controller.VacinaCatalogoController"
      spacing="12" prefWidth="720" style="-fx-background-color: white;">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25" />
    </padding>

    <Label text="Catálogo de vacinas" textFill="#13352c">
        <font>
            <Font name="System Bold" size="20" />
        </font>
    </Label>

    <!-- Novo à direita, no mesmo padrão das outras telas -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Novo" onAction="#novo" prefHeight="35" textFill="WHITE"
                style="-fx-background-color: #12805d;">
            <font>
                <Font name="System Bold" size="13" />
            </font>
        </Button>
    </HBox>

    <TableView fx:id="tabela" prefHeight="300">
        <columns>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="180" />
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110" />
            <TableColumn fx:id="colDosagem" text="Dosagem" prefWidth="100" />
            <TableColumn fx:id="colPeriodicidade" text="Periodicidade (dias)" prefWidth="140" />
            <TableColumn fx:id="colFabricante" text="Fabricante" prefWidth="140" />
        </columns>
    </TableView>

    <!-- Ações sobre o item selecionado, e Fechar à direita -->
    <HBox spacing="10">
        <Button text="Editar" onAction="#editar" prefHeight="35" />
        <Button text="Excluir" onAction="#excluir" prefHeight="35" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Fechar" onAction="#fechar" prefHeight="35" />
    </HBox>

    <Label fx:id="lblMensagem" textFill="RED" wrapText="true" />
</VBox>