<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Tela Notificações (protótipos 06 e 09): lista de lembretes e envio pelo WhatsApp -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.pi3sem.desktop.controller.NotificacoesController"
      spacing="15" style="-fx-background-color: white;">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <Label text="Notificações" textFill="#13352c">
        <font>
            <Font name="System Bold" size="24" />
        </font>
    </Label>

    <!-- Filtro à esquerda, geração de lembretes à direita -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Mostrar:" />
        <ComboBox fx:id="cbFiltro" prefHeight="35" prefWidth="160" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Gerar lembretes" onAction="#gerarLembretes" prefHeight="35" />
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- Lista de notificações -->
        <TableView fx:id="tabela" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colData" text="Data" prefWidth="90" />
                <TableColumn fx:id="colTutor" text="Tutor" prefWidth="160" />
                <TableColumn fx:id="colTipo" text="Motivo" prefWidth="170" />
                <TableColumn fx:id="colStatus" text="Status" prefWidth="90" />
            </columns>
        </TableView>

        <!-- Painel de envio da notificação selecionada -->
        <VBox spacing="8" prefWidth="380"
              style="-fx-background-color: #f4f7f5; -fx-background-radius: 12;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <Label text="Enviar mensagem" textFill="#13352c">
                <font>
                    <Font name="System Bold" size="16" />
                </font>
            </Label>

            <Label text="Para" textFill="GRAY" />
            <Label fx:id="lblDestinatario" text="Selecione uma notificação na lista">
                <font>
                    <Font name="System Bold" size="14" />
                </font>
            </Label>

            <Label text="Motivo" textFill="GRAY" />
            <Label fx:id="lblMotivo" text="-" />

            <Label text="Mensagem (pode editar antes de enviar)" textFill="GRAY" />
            <TextArea fx:id="txtMensagem" wrapText="true" VBox.vgrow="ALWAYS" />

            <Button fx:id="btnEnviar" text="Enviar pelo WhatsApp" onAction="#enviar"
                    maxWidth="Infinity" prefHeight="40" textFill="WHITE"
                    style="-fx-background-color: #12805d;">
                <font>
                    <Font name="System Bold" size="14" />
                </font>
            </Button>
        </VBox>
    </HBox>

    <Label fx:id="lblMensagem" textFill="RED" wrapText="true" />
</VBox>