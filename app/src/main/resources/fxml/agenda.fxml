<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Tela Agenda (protótipo 07, simplificado): agendamentos de um dia -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.pi3sem.desktop.controller.AgendaController"
      spacing="15" style="-fx-background-color: white;">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <Label text="Agenda" textFill="#13352c">
        <font>
            <Font name="System Bold" size="24" />
        </font>
    </Label>

    <!-- Escolha do dia à esquerda, botão principal à direita -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="◀" onAction="#diaAnterior" prefHeight="35" />
        <Button text="Hoje" onAction="#hoje" prefHeight="35" />
        <Button text="▶" onAction="#proximoDia" prefHeight="35" />
        <DatePicker fx:id="dpData" prefHeight="35" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Novo agendamento" onAction="#novo" prefHeight="35" textFill="WHITE"
                style="-fx-background-color: #12805d;">
            <font>
                <Font name="System Bold" size="13" />
            </font>
        </Button>
    </HBox>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colHora" text="Horário" prefWidth="80" />
            <TableColumn fx:id="colAnimal" text="Animal" prefWidth="140" />
            <TableColumn fx:id="colTutor" text="Tutor" prefWidth="160" />
            <TableColumn fx:id="colVacina" text="Vacina" prefWidth="140" />
            <TableColumn fx:id="colStatus" text="Status" prefWidth="110" />
            <TableColumn fx:id="colObservacao" text="Observação" prefWidth="220" />
        </columns>
    </TableView>

    <!-- Ações sobre o agendamento selecionado -->
    <HBox spacing="10">
        <Button text="Editar" onAction="#editar" prefHeight="35" />
        <Button text="Confirmar" onAction="#confirmar" prefHeight="35" />
        <Button text="Cancelar agendamento" onAction="#cancelar" prefHeight="35" />
        <Button text="Excluir" onAction="#excluir" prefHeight="35" />
    </HBox>

    <Label fx:id="lblMensagem" textFill="RED" />
</VBox>